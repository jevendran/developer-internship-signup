{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PHP Server",
      "type": "shell",
      "command": "php",
      "args": [
        "-S",
        "127.0.0.1:8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run PHP Server with XAMPP",
      "type": "shell",
      "command": "C:\\xampp\\php\\php.exe",
      "args": [
        "-S",
        "127.0.0.1:8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Full Stack with Docker",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "up",
        "--build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
